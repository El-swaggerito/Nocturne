# Obtain a Cloud API key from https://near.ai/.
# Copy to .env at repository root, and NEVER commit the .env file.
NEAR_AI_KEY=replace-with-your-near-ai-cloud-key
NEAR_AI_MODEL=deepseek/deepseek-v3.2

# Key setup, allowance and revocation: docs/security/agent-permissions.md (#4).
# Issue #10: only use a dedicated testnet FunctionCall key authorised for
# receiver=NEAR_GUARD_ACCOUNT_ID and method_names=["request_payment"].
# NEVER supply an owner or FullAccess key. No key is committed to Git.
NEAR_NETWORK=testnet
NEAR_GUARD_ACCOUNT_ID=guard.testnet
NEAR_AGENT_ACCOUNT_ID=agent.testnet
# Do NOT put a real private key in this example; set locally in .env only.
NEAR_AGENT_PRIVATE_KEY=replace-with-restricted-testnet-key
# Local state must persist across process restarts; the directory is gitignored.
NEAR_PAYMENT_JOURNAL_DIR=.local/payment-requests
# Live transaction submission is disabled until #4/#6 approval and #14 testing.
NEAR_ENABLE_TESTNET_WRITES=no
NEAR_CONTRACT_INTERFACE_AGREED=no
