{
  "name": "@nocturne/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/config.test.js dist/tests/inference.test.js dist/tests/types.test.js dist/tests/invoice.test.js dist/tests/near.test.js",
    "smoke": "npm run build && node --env-file-if-exists=../.env dist/src/cli.js fixtures/valid-invoice.txt",
    "demo:submit": "npm run build && node --env-file=../.env dist/src/demo-runner.js"
  },
  "dependencies": {
    "near-api-js": "7.4.0",
    "openai": "7.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  }
}
